{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hai.local/contracts/run-contract.schema.json",
  "title": "HAI bounded run contract",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "run_id",
    "lane_id",
    "created_at",
    "goal",
    "non_goal",
    "boundaries",
    "dod",
    "stop_criterion",
    "harnesses",
    "control_plane",
    "budgets",
    "status"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "lane_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "goal": { "type": "string", "minLength": 1 },
    "non_goal": { "type": "string", "minLength": 1 },
    "boundaries": {
      "type": "object",
      "required": ["write_roots", "forbidden_paths"],
      "properties": {
        "write_roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "forbidden_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "dod": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion", "evidence_paths"],
        "properties": {
          "criterion": { "type": "string", "minLength": 1 },
          "evidence_paths": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    },
    "stop_criterion": { "type": "string", "minLength": 1 },
    "harnesses": {
      "type": "object",
      "required": ["worker", "reviewer", "same_harness_owner_exception"],
      "properties": {
        "worker": {
          "type": ["object", "null"],
          "properties": { "id": { "type": "string", "minLength": 1 } },
          "required": ["id"],
          "additionalProperties": false
        },
        "reviewer": {
          "type": ["object", "null"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "read_only": { "const": true }
          },
          "required": ["id", "read_only"],
          "additionalProperties": false
        },
        "same_harness_owner_exception": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "control_plane": {
      "type": "object",
      "required": [
        "primary_binding",
        "path",
        "status",
        "adapter_id",
        "hai_fail_id",
        "backfill_required"
      ],
      "properties": {
        "primary_binding": { "const": "hai-mcp" },
        "path": { "enum": ["primary_hai_mcp", "bootstrap_adapter"] },
        "status": { "enum": ["NORMAL", "DEGRADED"] },
        "adapter_id": { "type": ["string", "null"] },
        "hai_fail_id": { "type": ["string", "null"] },
        "backfill_required": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "path": { "const": "primary_hai_mcp" } } },
          "then": {
            "properties": {
              "status": { "const": "NORMAL" },
              "adapter_id": { "const": null },
              "hai_fail_id": { "const": null },
              "backfill_required": { "const": false }
            }
          }
        },
        {
          "if": { "properties": { "path": { "const": "bootstrap_adapter" } } },
          "then": {
            "properties": {
              "status": { "const": "DEGRADED" },
              "adapter_id": { "type": "string", "minLength": 1 },
              "hai_fail_id": { "type": "string", "minLength": 1 },
              "backfill_required": { "const": true }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "budgets": {
      "type": "object",
      "required": ["hot_path_seconds", "feedback_seconds"],
      "properties": {
        "hot_path_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "feedback_seconds": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "status": { "enum": ["planned", "running", "DONE", "PARKED", "BLOCKED"] },
    "result": {
      "type": "object",
      "required": ["summary", "evidence_paths", "next_step"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "evidence_paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "next_step": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["DONE", "PARKED", "BLOCKED"] } } },
      "then": { "required": ["result"] }
    }
  ],
  "additionalProperties": false
}
