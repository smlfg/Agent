{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hai.local/contracts/hai-fail.schema.json",
  "title": "HAI fail learning record",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "id",
    "title",
    "observed_at",
    "status",
    "expected",
    "observed",
    "attempts",
    "safety_boundary",
    "evidence_paths",
    "regression_test",
    "content_policy",
    "next_step"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[0-9]{4}-[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "observed_at": { "type": "string", "format": "date" },
    "status": { "enum": ["open", "mitigated", "closed"] },
    "expected": { "type": "string", "minLength": 1 },
    "observed": { "type": "string", "minLength": 1 },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["method", "result"],
        "properties": {
          "method": { "type": "string", "minLength": 1 },
          "result": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "safety_boundary": { "type": "string", "minLength": 1 },
    "evidence_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "regression_test": {
      "type": "object",
      "required": ["status", "goal", "precondition", "success"],
      "properties": {
        "status": { "enum": ["desired", "ready", "passing", "failing"] },
        "goal": { "type": "string", "minLength": 1 },
        "precondition": { "type": "string", "minLength": 1 },
        "success": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "content_policy": {
      "type": "object",
      "required": ["secrets_stored", "hidden_reasoning_stored"],
      "properties": {
        "secrets_stored": { "const": false },
        "hidden_reasoning_stored": { "const": false }
      },
      "additionalProperties": false
    },
    "next_step": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}

