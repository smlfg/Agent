{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hai.local/contracts/consolidation-map.schema.json",
  "title": "HAI consolidation map — N thoughts to M implementation targets",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "id",
    "family_id",
    "title",
    "member_ids",
    "implementation_targets",
    "parked",
    "cardinality_rule",
    "next_implementation",
    "created_at"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "family_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "member_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "description": "Intake, park, project, or tree-node IDs in this family"
    },
    "implementation_targets": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "objective",
          "non_goals",
          "write_root",
          "depends_on",
          "evidence_paths"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "objective": {
            "type": "string",
            "minLength": 1,
            "description": "Exactly one sentence: what holds when done"
          },
          "non_goals": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "write_root": {
            "type": "string",
            "minLength": 1,
            "description": "Absolute or repo-relative write root, or the literal PARKED"
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "evidence_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    },
    "parked": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "summary", "resume_point"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "resume_point": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "description": "Thought that was captured but must not be built now"
    },
    "cardinality_rule": {
      "type": "object",
      "required": ["max_targets"],
      "properties": {
        "max_targets": {
          "type": "integer",
          "const": 3,
          "description": "Hard cap; implementation_targets.length must be <= this"
        }
      },
      "additionalProperties": false
    },
    "next_implementation": {
      "type": ["string", "null"],
      "description": "Exactly one implementation_targets[].id that may enter Distill/Run, or null"
    },
    "created_at": { "type": "string", "format": "date-time" },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
