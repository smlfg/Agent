{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hai.local/contracts/session-event.schema.json",
  "title": "HAI durable session event",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "event_id",
    "session_id",
    "occurred_at",
    "type",
    "actor",
    "payload",
    "evidence_paths",
    "content_policy"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "1.0.0" },
    "event_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "type": {
      "enum": [
        "capture",
        "structured",
        "dispatch",
        "progress",
        "drift_detected",
        "branched",
        "resumed",
        "done",
        "parked",
        "blocked"
      ]
    },
    "actor": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["human", "main_session", "worker", "reviewer", "system"] },
        "id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "payload": { "type": "object" },
    "evidence_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "next_step": { "type": "string", "minLength": 1 },
    "content_policy": {
      "type": "object",
      "required": ["secrets_stored", "hidden_reasoning_stored"],
      "properties": {
        "secrets_stored": { "const": false },
        "hidden_reasoning_stored": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

