// agentfähig.de (Worker "agentfaehig"). Living Surface as homepage + /api/agent.
// KEINE routes: die bestehenden Custom Domains (xn--agentfhig-02a.de, www.xn--agentfhig-02a.de) bleiben.
// Vorherige Startseite unter /classic/. Secret MINIMAX_API_KEY setzt der Owner selbst.
{
  "name": "agentfaehig",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-25",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "vars": {
    "MINIMAX_MODEL": "MiniMax-M3.1-Flash",
    "OPENAI_BASE_URL": "https://openrouter.ai/api/v1",
    "OPENAI_MODEL": "deepseek/deepseek-v4.1-flash",
    "WORKERS_AI_MODEL": "@cf/zai-org/glm-4.7-flash"
  },
  "observability": { "enabled": true }
}
